          <mxGeometry x="170" y="240" width="230" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="edge1" value="FK" edge="1" parent="1" source="tEmprunts" target="tLivres">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge2" value="FK" edge="1" parent="1" source="tEmprunts" target="tUsagers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
